# 값은 여기에 적지 않습니다. 배포 플랫폼 환경변수와 로컬 .env.local 에만 넣습니다.
# 아래는 Next.js 이름입니다. Vite 면 NEXT_PUBLIC_ 을 VITE_ 로 바꿉니다 (supabaseauthloginguide.md §3).

# 브라우저용 — 사내 계정 로그인 (ai_data_hub)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — NEXT_PUBLIC_ / VITE_ 를 붙이지 않습니다
# AccessHub 「DB 비밀번호 발급」의 접속 주소 (<스키마>_app 계정). DB 를 쓰는 앱만.
# 같은 값을 GitHub 저장소 Secret DATABASE_URL 에도 넣습니다 (DB 자동 적용, CLAUDE.md 2번).
DATABASE_URL=
